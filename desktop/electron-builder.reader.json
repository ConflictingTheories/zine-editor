{
  "appId": "com.svrn.publisher.reader",
  "productName": "SVRN Publisher Reader",
  "asar": true,
  "asarUnpack": [
    "node_modules/sqlite3/**/*"
  ],
  "files": [
    "desktop/**/*",
    "dist-editor/**/*",
    "dist-reader/**/*",
    "server/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "desktop/reader-main.cjs"
  },
  "mac": {
    "category": "public.app-category.books",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis", "zip"]
  },
  "linux": {
    "category": "Office",
    "target": ["AppImage", "deb"]
  }
}