# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=longform
POSTGRES_USER=longform_user
POSTGRES_PASSWORD=change_this_strong_password

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_string

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...           # use sk_test_... for development
STRIPE_PUBLISHABLE_KEY=pk_live_...      # use pk_test_... for development

# Webhook secret — from Stripe dashboard > Webhooks > your endpoint > Signing secret
# For local dev: stripe listen --forward-to localhost:4000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com     # no trailing slash
