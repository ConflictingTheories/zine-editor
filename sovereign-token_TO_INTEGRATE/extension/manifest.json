{
  "manifest_version": 3,
  "name": "Sovereign Keychain",
  "version": "1.0.0",
  "description": "Personal sovereignty token keychain and auto-decoder.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sovereign-sdk.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}