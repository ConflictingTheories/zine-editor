# ── SVRN Publisher API — environment template ─────────────────────────
# Copy to server/.env (dev) or inject via your orchestrator (prod).

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:80

# Database — pick ONE. Postgres is the production path; the migrations are
# written in plain knex so both work unchanged.
DB_PATH=./data/database.sqlite
# DATABASE_URL=postgres://svrn:svrn@db:5432/svrn

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The default below is REJECTED in production (see config.cjs).
JWT_SECRET=dev_secret_key_unsafe_for_production_only
JWT_EXPIRY=7d

# Asset storage — disk (dev default) or s3 (production)
ASSET_STORE=disk
ASSET_STORE_PATH=./data/assets
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # set for S3-compatible stores (MinIO, R2, …)
# S3_KEY_PREFIX=assets/
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via env or IAM)

# SVRN packages (published .svrn archives)
SVRN_PACKAGES_PATH=./data/svrn-packages
SVRN_NODE_NAME=SVRN Publishing Node

# Stripe — unset = simulated payments (dev). Set for the real rail.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Demo account (dev convenience)
ALLOW_DEMO_ACCOUNT=true
